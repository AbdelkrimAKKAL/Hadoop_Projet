# Copier ce fichier en ".env" et adapter les valeurs a ta machine (le .env n'est pas commite)

# Chemin d'installation du JDK 17 (requis par Spark)
JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17.0.19.10-hotspot

# URI du NameNode HDFS local (port selon fs.defaultFS dans core-site.xml, souvent 9000 ou 8020)
HDFS_URI=hdfs://localhost:9000
